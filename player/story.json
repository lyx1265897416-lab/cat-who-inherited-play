-core-aicap/uploads/usr_4a6e5fb234d64da0a9429e519b299f07/local/uau_3542bd7fe4e841f191bf7c6da95ca72e-e3_paid.mp4"}, "idle": null, "captions": [], "look": "D2"}, "e3_celeste": {"ep": 3, "title_en": "Vivienne", "title_zh": "薇薇安", "next": null, "media": {"none": "https://storage.googleapis.com/waku-core-aicap/uploads/usr_4a6e5fb234d64da0a9429e519b299f07/local/uau_ab4a386d5fe948ccad9c59f94ddfaf1b-e3_celeste.mp4"}, "idle": "https://storage.googleapis.com/waku-core-aicap/uploads/usr_4a6e5fb234d64da0a9429e519b299f07/local/uau_95e0e7d364cc45ecbf618ed5f3b80244-e3_celeste.mp4", "captions": [{"s": 1.2, "e": 3.85, "who": "IVY", "en": "Thank you for bringing me out for all this, Pemberton.", "zh": "谢谢你带我出来买这些，彭伯顿。"}, {"s": 5.24, "e": 7.23, "who": "VIVIENNE", "en": "Well. Look who it is.", "zh": "哟，看看这是谁。"}, {"s": 11.45, "e": 16.04, "who": "VIVIENNE", "en": "One day with the card, and you're already shopping like an heiress.", "zh": "才拿到卡一天，就已经像个女继承人一样买买买了。"}, {"s": 16.59, "e": 18.58, "who": "VIVIENNE", "en": "That didn't take long, did it?", "zh": "还真快啊，是不是？"}], "look": "D2", "choice": {"kicker_en": "YOUR CHOICE", "kicker_zh": "你的选择", "q_en": "How do you respond?", "q_zh": "你怎么回应？", "lead": 2.32, "options": [{"en": "Explain", "zh": "解释清楚", "goto": "e3_A", "effects": {"family": 3}, "premium": false}, {"en": "Fight back", "zh": "怼回去", "goto": "e3_B", "effects": {"family": -5}, "premium": false}]}}, "e3_A": {"ep": 3, "title_en": "Explain", "title_zh": "解释", "next": "e3_A2", "media": {"none": "https://storage.googleapis.com/waku-core-aicap/uploads/usr_4a6e5fb234d64da0a9429e519b299f07/local/uau_d0ab3e6bd7f04a01bca0c28f0e8c9be3-e3_A.mp4"}, "idle": null, "captions": [{"s": 0.27, "e": 1.76, "who": "IVY", "en": "They're essentials.", "zh": "这些都是必需品。"}, {"s": 3.74, "e": 5.57, "who": "IVY", "en": "It was Pemberton's idea.", "zh": "是彭伯顿的主意。"}, {"s": 6.4, "e": 8.61, "who": "IVY", "en": "Every bit of it is for Earl Grey.", "zh": "每一样都是给伯爵的。"}], "look": "D2"}, "e3_A2": {"ep": 3, "title_en": "Madam's instructions", "title_zh": "夫人的吩咐", "next": "e4b_open0", "media": {"none": "https://storage.googleapis.com/waku-core-aicap/uploads/usr_4a6e5fb234d64da0a9429e519b299f07/local/uau_745515eea135480eafb408f4e7fc3a8d-e3_A2.mp4"}, "idle": null, "captions": [{"s": 0.21, "e": 2.4, "who": "PEMBERTON", "en": "Madam's instructions, Miss Vivienne.", "zh": "这是夫人的吩咐，薇薇安小姐。"}], "look": "D2", "summary": {"note_en": "Pemberton backed you up, and for once Vivienne had nothing to say. Cashmere, sheepskin and silk: His Lordship approves... but every purchase will be reviewed.", "note_zh": "彭伯顿站在了你这边，薇薇安难得无话可说。羊绒、羊皮、真丝——伯爵很满意……但每一笔消费，都会被审查。"}}, "e3_B": {"ep": 3, "title_en": "Fight back", "title_zh": "怼回去", "next": "e4b_open0", "media": {"none": "https://storage.googleapis.com/waku-core-aicap/uploads/usr_4a6e5fb234d64da0a9429e519b299f07/local/uau_74e8439026d342db9e0a6e82516fce14-e3_B.mp4"}, "idle": null, "captions": [{"s": 1.2, "e": 3.49, "who": "IVY", "en": "The card was given to me.", "zh": "这张卡是交给我的。"}, {"s": 4.92, "e": 7.25, "who": "IVY", "en": "How I use it is none of your business.", "zh": "我怎么用，跟你没关系。"}], "look": "D2", "summary": {"note_en": "You stood your ground. Vivienne won't forget it, and every purchase will be reviewed.", "note_zh": "你寸步不让。薇薇安不会忘记这一天，而每一笔消费，都会被审查。"}}, "e4b_open0": {"ep": 4, "title_en": "Back at Whitmore House", "title_zh": "回到庄园", "next": "e4b_home1", "media": {"none": "https://storage.googleapis.com/waku-core-aicap/uploads/usr_4a6e5fb234d64da0a9429e519b299f07/02bdc2a4745c48b28f40efc01a3e9c2d/e4b_open0.mp4"}, "idle": null, "captions": [], "look": null, "cards": [{"at": 0.3, "dur": 3.2, "k_en": "EPISODE FOUR", "k_zh": "第四集", "t_en": "The Night Visitor", "t_zh": "深夜来客"}]}, "e4b_home1": {"ep": 4, "title_en": "The new bed", "title_zh": "新床", "next": "e4b_home2", "media": {"none": "https://storage.googleapis.com/waku-core-aicap/uploads/usr_4a6e5fb234d64da0a9429e519b299f07/a765870b438d460bad53e7fc8e7179a2/e4b_home1.mp4"}, "idle": null, "captions": [{"s": 8.4