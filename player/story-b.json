, "who": "PEMBERTON", "en": "We're going shopping.", "zh": "我们去购物。"}], "look": "D2", "qte": {"kind": "tap", "icon": "🚗", "en": "Get in the car", "zh": "上车", "prompt_en": "Downtown awaits", "prompt_zh": "出发去市中心", "hint_en": "Tap to get in", "hint_zh": "点击上车", "goto": "e3_arrive", "timeout": "e3_arrive", "seconds": null, "danger": false, "ok": {}, "lead": 0.3}}, "e3_arrive": {"ep": 3, "title_en": "Halloway's", "title_zh": "霍洛威精品店", "next": "e3_enter", "media": {"none": "https://storage.googleapis.com/waku-core-aicap/uploads/usr_4a6e5fb234d64da0a9429e519b299f07/local/uau_98d4f2c1a91848259c0597caaffc9961-e3_arrive.mp4"}, "idle": null, "captions": [], "look": "D2", "cards": [{"at": 0.3, "dur": 2.6, "k_en": "", "k_zh": "", "t_en": "Halloway's", "t_zh": "霍洛威精品店"}]}, "e3_enter": {"ep": 3, "title_en": "Inside Halloway's", "title_zh": "走进精品店", "next": "e3_shop", "media": {"none": "https://storage.googleapis.com/waku-core-aicap/uploads/usr_4a6e5fb234d64da0a9429e519b299f07/local/uau_5b78c83852ac4f91be790f3ec1092023-e3_enter.mp4"}, "idle": null, "captions": [], "look": "D2"}, "e3_shop": {"ep": 3, "title_en": "Retail therapy", "title_zh": "买买买", "next": null, "media": {"none": "https://storage.googleapis.com/waku-core-aicap/uploads/usr_4a6e5fb234d64da0a9429e519b299f07/local/uau_1ff46039a1de44be8ef550fb117150d7-e3_shop.mp4"}, "idle": "https://storage.googleapis.com/waku-core-aicap/uploads/usr_4a6e5fb234d64da0a9429e519b299f07/2651cc7f60bb49b7b1592be7e4820ab8/e3_shop.mp4", "captions": [], "look": "D2", "qte": {"kind": "pay", "icon": "💳", "en": "Tap to pay", "zh": "刷卡", "prompt_en": "Tap to pay", "prompt_zh": "刷卡付款", "hint_en": "Tap the card three times", "hint_zh": "连点三下黑卡", "goto": "e3_paid", "timeout": "e3_paid", "seconds": null, "danger": false, "ok": {}, "lead": 3.0}}, "e3_paid": {"ep": 3, "title_en": "Approved", "title_zh": "支付成功", "next": "e3_celeste", "media": {"none": "https://storage.googleapis.com/waku-core-aicap/uploads/usr_4a6e5fb234d64da0a9429e519b299f07/local/uau_3542bd7fe4e841f191bf7c6da95ca72e-e3_paid.mp4"}, "idle": null, "captions": [], "look": "D2"}, "e3_celeste": {"ep": 3, "title_en": "Vivienne", "title_zh": "薇薇安", "next": null, "media": {"none": "https://storage.googleapis.com/waku-core-aicap/uploads/usr_4a6e5fb234d64da0a9429e519b299f07/local/uau_ab4a386d5fe948ccad9c59f94ddfaf1b-e3_celeste.mp4"}, "idle": "https://storage.googleapis.com/waku-core-aicap/uploads/usr_4a6e5fb234d64da0a9429e519b299f07/local/uau_95e0e7d364cc45ecbf618ed5f3b80244-e3_celeste.mp4", "captions": [{"s": 1.2, "e": 3.85, "who": "IVY", "en": "Thank you for bringing me out for all this, Pemberton.", "zh": "谢谢你带我出来买这些，彭伯顿。"}, {"s": 5.24, "e": 7.23, "who": "VIVIENNE", "en": "Well. Look who it is.", "zh": "哟，看看这是谁。"}, {"s": 11.45, "e": 16.04, "who": "VIVIENNE", "en": "One day with the card, and you're already shopping like an heiress.", "zh": "才拿到卡一天，就已经像个女继承人一样买买买了。"}, {"s": 16.59, "e": 18.58, "who": "VIVIENNE", "en": "That didn't take long, did it?", "zh": "还真快啊，是不是？"}], "look": "D2", "choice": {"kicker_en": "YOUR CHOICE", "kicker_zh": "你的选择", "q_en": "How do you respond?", "q_zh": "你怎么回应？", "lead": 2.32, "options": [{"en": "Explain", "zh": "解释清楚", "goto": "e3_A", "effects": {"family": 3}, "premium": false}, {"en": "Fight back", "zh": "怼回去", "goto": "e3_B", "effects": {"family": -5}, "premium": false}]}}, "e3_A": {"ep": 3, "title_en": "Explain", "title_zh": "解释", "next": "e3_A2", "media": {"none": "https://storage.googleapis.com/waku-core-aicap/uploads/usr_4a6e5fb234d64da0a9429e519b299f07/local/uau_d0ab3e6bd7f04a01bca0c28f0e8c9be3-e3_A.mp4"}, "idle": null, "captions": [{"s": 0.27, "e": 1.76, "who": "IVY", "en": "They're essentials.", "zh": "这些都是必需品。"}, {"s": 3.74, "e": 5.57, "who": "IVY", "en": "It was Pemberton's idea.", "zh": "是彭伯顿的主意。"}, {"s": 6.4, "e": 8.61, "who": "IVY", "en": "Every bit of it is for Earl Grey.", "zh": "每一样都是给伯爵的。"}], "look": "D2"}, "e3_A2": {"ep": 3, "title_en": "Madam's instructions", "title_zh": "夫人的吩咐", "next": "e4b_open0", "media": {"none": "https://storage.googleapis.com/waku-core-aicap/uploads/usr_4a6e5fb234d64da0a9429e519b299f07/local/uau_745515eea135480eafb408f4e7fc3a8d-e3_A2.mp4"}, "idle": null, "captions": [{"s": 0.21, "e": 2.4, "who": "PEMBERTON", "en": "Madam's instructions, Miss Vivienne.", "zh": "这是夫人的吩咐，薇薇安小姐。"}], "look": "D2", "summary": {"note_en": "Pemberton backed you up, and for once Vivienne had nothing to say. Cashmere, sheepskin and silk: His Lordship approves... but every purchase will be reviewed.", "note_zh": "彭伯顿站在了你这边，薇薇安难得无话可说。羊绒、羊皮、真丝——伯爵很满意……但每一笔消费，都会被审查。"}}, "e3_B": {"ep": 3, "title_en": "Fight back", "title_zh": "怼回去", "next": "e4b_open0", "media": {"none": "https://storage.googleapis.com/waku-core-aicap/uploads/usr_4a6e5fb234d64da0a9429e519b299f07/local/uau_74e8439026d342db9e0a6e82516fce14-e3_B.mp4"}, "idle": null, "captions": [{"s": 1.2, "e": 3.49, "who": "IVY", "en": "The card was given to me.", "zh": "这张卡是交给我的。"}, {"s": 4.92, "e": 7.25, "who": "IVY", "en": "How I use it is none of your business.", "zh": "我怎么用，跟你没关系。"}], "look": "D2", "summary": {"note_en": "You stood your ground. Vivienne won't forget it, and every purchase will be reviewed.", "note_zh": "你寸步不让。薇薇安不会忘记这一天，而每一笔消费，都会被审查。"}}, "ep5": {"ep": 5, "title_en": "Episode 5", "title_zh": "第 5 集", "next": null, "media": {}, "idle": null, "captions": [], "look": null, "end": true, "kicker_en": "Coming soon", "kicker_zh": "敬请期待", "note_en": "Edmund knows the letter exists. Your choices so far will follow you there.", "note_zh": "埃德蒙知道这封信的存在。你做过的每个选择，都会跟着你走下去。"}, "e4b_open0": {"ep": 4, "title_en": "Back at Whitmore House", "title_zh": "回到庄园", "next": "e4b_home1", "media": {"none": "https://storage.googleapis.com/waku-core-aicap/uploads/usr_4a6e5fb234d64da0a9429e519b299f07/02bdc2a4745c48b28f40efc01a3e9c2d/e4b_open0.mp4"}, "idle": null, "captions": [], "look": null, "cards": [{"at": 0.3, "dur": 3.0, "k_en": "EPISODE FOUR", "k_zh": "第四集", "t_en": "The Night Visitor", "t_zh": "深夜来客"}]}, "e4b_home1": {"ep": 4, "title_en": "The new bed", "title_zh": "新床", "next": "e4b_home2", "media": {"none": "https://storage.googleapis.com/waku-core-aicap/uploads/usr_4a6e5fb234d64da0a9429e519b299f07/a765870b438d460bad53e7fc8e7179a2/e4b_home1.mp4"}, "idle": null, "captions": [{"s": 8.44, "e": 11.91, "who": "IVY", "en": "Well? Does His Lordship approve?", "zh": "怎么样？伯爵大人满意吗？"}], "look": "D2"}, "e4b_home2": {"ep": 4, "title_en": "A word", "title_zh": "借一步说话", "next": "e4b_night0", "media": {"none": "https://storage.googleapis.com/waku-core-aicap/uploads/usr_4a6e5fb234d64da0a9429e519b299f07/3fb2bc4b04a140989122f7c3c165c4ec/e4b_home2.mp4"}, "idle": null, "captions": [{"s": 2.7, "e": 7.11, "who": "PEMBERTON", "en": "Miss Hart, a word. Last night, someone tried His Lordship's door.", "zh": "哈特小姐，借一步说话。昨天夜里，有人试着开过伯爵的门。"}, {"s": 7.1, "e": 8.39, "who": "IVY", "en": "Someone? Who?", "zh": "有人？是谁？"}, {"s": 8.4, "e": 12.13, "who": "PEMBERTON", "en": "I couldn't say. But whoever it was, they were looking for something.", "zh": "这我说不好。但不管是谁，他是在找东西。"}], "look": "D2"}, "e4b_night0": {"ep": 4, "title_en": "That night", "title_zh": "当晚", "next": "e4b_scratch1", "media": {"none": "https://storage.googleapis.com/waku-core-aicap/uploads/usr_4a6e5fb234d64da0a9429e519b299f07/ff68c08782c94545971187fb4d43f95a/e4b_night0.mp4"}, "idle": null, "captions": [], "look": null, "cards": [{"at": 0.3, "dur": 2.4, "k_en": "", "k_zh": "", "t_en": "That night", "t_zh": "当晚"}]}, "e4b_scratch1": {"ep": 4, "title_en": "He heard it", "title_zh": "他听见了", "next": "e4b_scratch2", "media": {"none": "https://storage.googleapis.com/waku-core-aicap/uploads/usr_4a6e5fb234d64da0a9429e519b299f07/1500286ce6c245f5a787921c1e4ec2cd/e4b_scratch1.mp4"}, "idle": null, "captions": [], "look": "NIGHT"}, "e4b_scratch2": {"ep": 4, "title_en": "At the door", "title_zh": "挠门", "next": null, "media": {"none": "https://storage.googleapis.com/waku-core-aicap/uploads/usr_4a6e5fb234d64da0a9429e519b299f07/eb9584d2d73a433ea3f0a13430cb5ce9/e4b_scratch2.mp4"}, "idl